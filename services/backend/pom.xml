<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.7</version>
        <relativePath/>
    </parent>

    <groupId>com.lumora</groupId>
    <artifactId>lumora-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>lumora-backend</name>
    <description>Lumora POS backend. One jar, two profiles: desktop (the shop PC) and cloud.</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            BCrypt for the manager PIN (M2-07). The crypto module alone, not
            spring-boot-starter-security: the starter would install a filter chain and
            authenticate every endpoint on a loopback API that deliberately has no auth
            until M3-09. What is wanted here is one password encoder.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!--
            JJWT for the offline session token (M3-09). A real library rather than sixty
            lines of Mac + Base64url: hand-rolled JWT verification is where alg-confusion
            bugs live, and "we only ever accept HS256" is a sentence every vulnerable
            implementation also contained. api at compile scope, impl and jackson at
            runtime - that split is what stops application code reaching past the facade.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Tests run against a real Postgres, never H2. This system's correctness rests on
          Postgres-specific behaviour - ON CONFLICT upserts keyed on client_uuid, partial
          indexes on the outbox, timestamptz. An in-memory stand-in would pass while the
          real thing failed.

          The database comes from `docker compose up -d db-test`, not Testcontainers:
          Docker Desktop 29 on Windows answers docker-java's /info probe with an empty
          HTTP 400 on every named pipe, so Testcontainers cannot connect at all.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
