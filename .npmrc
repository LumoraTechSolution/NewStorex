# A real (non-symlinked) node_modules tree.
#
# Two things need this, both of them load-bearing for the desktop build:
#   1. Next's `output: 'standalone'` mirrors the dependency tree with symlinks, which
#      fails on Windows with EPERM unless Developer Mode is on. Requiring every dev
#      machine to flip an OS setting is not a dependency we want.
#   2. electron-builder cannot pack a symlinked pnpm store (M5-01).
#
# The cost is pnpm's phantom-dependency strictness. Accepted deliberately.
node-linker=hoisted

auto-install-peers=true
strict-peer-dependencies=false
