# Copy to .env for local development. Never commit .env.
#
# These credentials are development-only and are not the ones a real shop runs on —
# the installer provisions those at activation (M5-03).

# --- The shop PC's database (docker compose service: db-local) -----------------
# Source of truth for the sale. The backend's `desktop` profile points here.
# Port is 5442, not 5432: the previous POS stack still holds 5432 on this machine.
LOCAL_DB_PORT=5442
LOCAL_DB_PASSWORD=lumora
LOCAL_DATABASE_URL=jdbc:postgresql://127.0.0.1:5442/lumora_local
LOCAL_DATABASE_USER=lumora

# --- The cloud database (docker compose service: db-cloud) ---------------------
# Multi-tenant ingest and reporting. The backend's `cloud` profile points here.
CLOUD_DB_PORT=5443
CLOUD_DB_PASSWORD=lumora
CLOUD_DATABASE_URL=jdbc:postgresql://127.0.0.1:5443/lumora_cloud
CLOUD_DATABASE_USER=lumora

# --- Frontends -----------------------------------------------------------------
# The terminal talks to the local backend and nothing else.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8081
