{
  "name": "@lumora/terminal",
  "version": "0.0.0",
  "private": true,
  "description": "Lumora Terminal — cashier terminal and back office. Ships as a Windows installer and talks only to the local backend.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "electron": "electron electron/main.cjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const d of ['.next','.turbo']) require('node:fs').rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@lumora/api-client": "workspace:*",
    "@lumora/domain": "workspace:*",
    "@lumora/ui": "workspace:*",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
